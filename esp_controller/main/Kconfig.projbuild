menu "Drone controller"

    menu "Wi-Fi hotspot"
        config DRONE_WIFI_SSID
            string "Hotspot name (SSID)"
            default "DRONE_TEST"

        config DRONE_WIFI_PASSWORD
            string "Hotspot password"
            default "drone1234"
            help
                WPA2 password. It must contain at least 8 characters.

        config DRONE_WIFI_CHANNEL
            int "Wi-Fi channel"
            range 1 13
            default 6

        config DRONE_WIFI_MAX_CLIENTS
            int "Maximum connected clients"
            range 1 4
            default 2
    endmenu

    menu "STM32 UART link"
        config DRONE_UART_PORT
            int "UART controller number"
            range 0 2
            default 1

        config DRONE_UART_TX_GPIO
            int "ESP32-S3 TX GPIO (connect to STM32 USART1 RX/PA10)"
            range 0 48
            default 17

        config DRONE_UART_RX_GPIO
            int "ESP32-S3 RX GPIO (connect to STM32 USART1 TX/PA9)"
            range 0 48
            default 18

        config DRONE_UART_BAUD_RATE
            int "UART baud rate"
            range 115200 921600
            default 460800
    endmenu

    config DRONE_PHONE_TIMEOUT_MS
        int "Valid phone packet timeout (ms)"
        range 100 1000
        default 300

    config DRONE_STM32_TIMEOUT_MS
        int "STM32 status timeout shown by diagnostics (ms)"
        range 100 2000
        default 300

    menu "WS2812 status LED"
        config DRONE_STATUS_LED_GPIO
            int "WS2812 data GPIO"
            range 0 48
            default 48
            help
                GPIO that drives the first WS2812/NeoPixel data input. GPIO48
                is the onboard RGB LED on common ESP32-S3 DevKit boards.
    endmenu

endmenu
